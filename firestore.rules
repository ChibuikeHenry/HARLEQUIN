rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
          == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /submissions/{submissionId} {
        allow read, write: if ownsBusiness(businessId);
      }
    }
  }
}
